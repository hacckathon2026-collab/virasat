rules_version = '2';

// Who can read and write what in the Virasat database.
// Deploy after changing:  npx firebase-tools deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 24; }
    function games() { return ['match', 'quiz', 'festival', 'scramble']; }

    // ── Roles ──
    // Admins = exactly these emails (lowercase). Kept here, not in index.html, so the
    // public website never shows them. To add or remove an admin, edit this list and
    // publish the rules; the site updates their role on their next visit.
    function adminEmails() {
      return [
        'vedanshtyagi925@gmail.com',
        'shyamak@gmail.com',
        'ritvik-test@gmail.com',
        'paarthobuisness@gmail.com',
        'hacckathon2026@gmail.com',
        'abc@gmail.com',
        'advikdhiman@gmail.com',
        'virasat@gmail.com',
        'medhanshgulati05@gmail.com',
        'google@gmail.com'
      ];
    }
    function isAdminEmail() { return request.auth.token.email in adminEmails(); }
    // On the list → must be 'admin'. Everyone else → 'student' (there is no other role).
    function roleAllowed(r) { return isAdminEmail() ? r == 'admin' : r == 'student'; }

    // Lets the site ask "am I an admin?" without revealing the list: reading
    // adminCheck/<your own email> is allowed only if that email is on it. (No documents
    // live here; a person on the list gets "not found", everyone else gets "denied".)
    match /adminCheck/{email} {
      allow get: if signedIn() && email == request.auth.token.email && isAdminEmail();
    }

    // ── Profiles: users/{uid} — private to their owner ──
    function validProfile(d) {
      return d.keys().hasAll(['displayName', 'email', 'createdAt', 'lastLoginAt'])
        && d.keys().hasOnly(['displayName', 'email', 'role', 'language', 'theme', 'createdAt', 'lastLoginAt'])
        && validName(d.displayName)
        && d.email == request.auth.token.email
        && (!('role' in d) || roleAllowed(d.role))
        && (!('language' in d) || d.language in ['en', 'hi', 'sa'])
        && (!('theme' in d) || d.theme in ['dark', 'light'])
        && d.createdAt is timestamp
        && d.lastLoginAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // validProfile already pins the role (admin list → admin, everyone else → student),
      // so old 'teacher' or unlisted 'admin' profiles can only be corrected, never kept.
      // A role, once set, cannot be removed.
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.get('role', null) != null || resource.data.get('role', null) == null);
      allow delete: if false;
    }

    // ── Quiz questions added by admins: quizQuestions/{id} ──
    // Every signed-in player reads them (the games ask them first, before the built-in ones);
    // only admins can add or remove them, and nobody can edit one after it is saved.
    function validAnswer(o) { return o is string && o.size() >= 1 && o.size() <= 120; }
    function validQuestion(d) {
      return d.keys().hasAll(['game', 'q', 'opts', 'a', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['game', 'q', 'opts', 'a', 'createdBy', 'createdByName', 'createdAt'])
        && d.game in ['quiz', 'festival']
        && d.q is string && d.q.size() >= 5 && d.q.size() <= 300
        && d.opts is list && d.opts.size() == 4
        && validAnswer(d.opts[0]) && validAnswer(d.opts[1]) && validAnswer(d.opts[2]) && validAnswer(d.opts[3])
        && d.a is int && d.a >= 0 && d.a <= 3
        && d.createdBy == request.auth.uid
        && (!('createdByName' in d) || (d.createdByName is string && d.createdByName.size() <= 40))
        && d.createdAt == request.time;
    }

    match /quizQuestions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && isAdminEmail() && validQuestion(request.resource.data);
      allow delete: if signedIn() && isAdminEmail();
      allow update: if false;
    }

    // ── Leaderboards: leaderboards/{game}/entries/{uid} — one doc per player = their best ──
    // Limits are loose on purpose so the team can add quiz questions or cards
    // without touching these rules (up to 100 questions / 50 card pairs).
    function validEntry(game, d) {
      return d.uid == request.auth.uid
        && validName(d.displayName)
        && d.timeMs is int && d.timeMs >= 1000 && d.timeMs <= 3600000
        && d.plays is int
        && d.updatedAt == request.time
        && (game == 'match'
          ? d.keys().hasAll(['uid', 'displayName', 'moves', 'pairs', 'timeMs', 'plays', 'updatedAt'])
            && d.keys().hasOnly(['uid', 'displayName', 'moves', 'pairs', 'timeMs', 'plays', 'updatedAt'])
            && d.pairs is int && d.pairs >= 1 && d.pairs <= 50
            && d.moves is int && d.moves >= d.pairs * 2 && d.moves <= 5000
          : d.keys().hasAll(['uid', 'displayName', 'score', 'total', 'timeMs', 'plays', 'updatedAt'])
            && d.keys().hasOnly(['uid', 'displayName', 'score', 'total', 'timeMs', 'plays', 'updatedAt'])
            && d.total is int && d.total >= 1 && d.total <= 100
            && d.score is int && d.score >= 0 && d.score <= d.total);
    }

    // Higher score wins (fewer moves for Heritage Match); a tie goes to the faster time.
    function improved(game, n, o) {
      return game == 'match'
        ? (n.moves < o.moves || (n.moves == o.moves && n.timeMs < o.timeMs))
        : (n.score > o.score || (n.score == o.score && n.timeMs < o.timeMs));
    }

    // A slower or worse game still counts as a play, but must keep the old best.
    function keepsBest(game, n, o) {
      return game == 'match'
        ? (n.moves == o.moves && n.pairs == o.pairs && n.timeMs == o.timeMs)
        : (n.score == o.score && n.total == o.total && n.timeMs == o.timeMs);
    }

    // Admins may change just the score (moves for Heritage Match), within what is possible.
    function adminScoreEdit(game, n, o) {
      return n.diff(o).affectedKeys().hasOnly([game == 'match' ? 'moves' : 'score'])
        && (game == 'match'
          ? n.moves is int && n.moves >= o.pairs * 2 && n.moves <= 5000
          : n.score is int && n.score >= 0 && n.score <= o.total);
    }

    match /leaderboards/{game}/entries/{uid} {
      allow read: if signedIn() && game in games();
      allow create: if isOwner(uid) && game in games()
        && validEntry(game, request.resource.data)
        && request.resource.data.plays == 1;
      allow update: if game in games() && (
        (isOwner(uid)
          && validEntry(game, request.resource.data)
          && request.resource.data.plays == resource.data.plays + 1
          && (improved(game, request.resource.data, resource.data)
            || keepsBest(game, request.resource.data, resource.data)))
        || (signedIn() && isAdminEmail() && adminScoreEdit(game, request.resource.data, resource.data)));
      // Only admins can take an entry off a leaderboard (the player can play again to return).
      allow delete: if signedIn() && isAdminEmail() && game in games();
    }
  }
}
